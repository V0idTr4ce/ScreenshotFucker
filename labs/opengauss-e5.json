        "INSERT INTO Score VALUES ('2023105', 'MA202', 81.0);",
        "INSERT INTO Score VALUES ('2023105', 'GE101', 88.5);"
      ]
    },
    {
      "n": 29,
      "title": "课程成绩统计视图 CourseScoreStats",
      "script": [
        "CREATE VIEW CourseScoreStats AS",
        "SELECT c.course_id, c.course_name,",
        "       COUNT(s.student_id) AS student_count,",
        "       MAX(s.score) AS max_score,",
        "       MIN(s.score) AS min_score,",
        "       ROUND(AVG(s.score), 2) AS avg_score,",
        "       ROUND(STDDEV_SAMP(s.score), 2) AS score_stddev,",
        "       COUNT(CASE WHEN s.score >= 90 THEN 1 END) AS excellent_count,",
        "       COUNT(CASE WHEN s.score < 60 THEN 1 END) AS fail_count",
        "FROM Course c",
        "LEFT JOIN Score s ON c.course_id = s.course_id",
        "GROUP BY c.course_id, c.course_name;"
      ]
    },
    {
      "n": 30,
      "title": "班级课程成绩统计视图 ClassCourseScoreStats",
      "script": [
        "CREATE VIEW ClassCourseScoreStats AS",
        "SELECT st.class_name, c.course_id, c.course_name,",
        "       COUNT(s.score) AS student_count,",
        "       ROUND(AVG(s.score), 2) AS avg_score,",
        "       MEDIAN(s.score::double precision) AS median_score,",
        "       ROUND(VARIANCE(s.score), 2) AS score_variance,",
        "       LISTAGG(st.student_name || ':' || s.score::text, ', ')",
        "           WITHIN GROUP (ORDER BY s.score) AS score_detail",
        "FROM Student st",
        "JOIN Score s ON st.student_id = s.student_id",
        "JOIN Course c ON s.course_id = c.course_id",
        "GROUP BY st.class_name, c.course_id, c.course_name",
        "ORDER BY st.class_name, c.course_id;"
      ]
    },
    {
      "n": 31,
      "title": "查询全部课程成绩统计",
      "script": [
        "SELECT * FROM CourseScoreStats ORDER BY course_id;"
      ]
    },
    {
      "n": 32,
      "title": "查询 CS101 的统计",
      "script": [
        "SELECT * FROM CourseScoreStats WHERE course_id = 'CS101';"
      ]
    },
    {
      "n": 33,
      "title": "查询计算机1班的成绩统计",
      "script": [
        "SELECT * FROM ClassCourseScoreStats WHERE class_name = '计算机1班';"
      ]
    },
    {
      "n": 34,
      "title": "查询各班数据库原理的统计",
      "script": [
        "SELECT * FROM ClassCourseScoreStats WHERE course_name = '数据库原理';"
      ]
    }
