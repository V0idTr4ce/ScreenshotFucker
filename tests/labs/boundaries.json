{
  "schema_version": 1,
  "name": "boundary suite",
  "description": "Unicode, failed command, overflow, wide line, ANSI, password-looking text.",
  "vars": {
    "marker": "BOUNDARY_VAR_OK"
  },
  "settings": {
    "window_cols": 120,
    "window_rows": 36,
    "window_width": 1100,
    "window_height": 700,
    "buffer_rows": 800,
    "speed": 2,
    "clear_between": true,
    "capture_from_top": true
  },
  "session": {
    "open": [],
    "prepare_at": [],
    "from": {
      "connect_only_below": 1,
      "replay_from": 1
    }
  },
  "boxes": [
    {
      "n": 1,
      "title": "vars and CJK",
      "script": [
        "echo ${marker}",
        "echo 中文边界测试",
        "printf '%s\\n' '引号与美元$ok'"
      ]
    },
    {
      "n": 2,
      "title": "failed command then continue",
      "script": [
        "false",
        "echo AFTER_FALSE_OK"
      ]
    },
    {
      "n": 3,
      "title": "output taller than the window",
      "script": [
        "python3 -c 'print(\"LONG_START\");print(\"\\n\".join(str(i) for i in range(1,121)));print(\"LONG_END\")'"
      ]
    },
    {
      "n": 4,
      "title": "wide line wrap",
      "script": [
        "python3 -c \"print('WIDE_'+'W'*240)\""
      ]
    },
    {
      "n": 5,
      "title": "ANSI, quotes, fake password prompt",
      "script": [
        "printf '\\033[31mRED_OK\\033[0m\\n'",
        "echo Password:",
        "echo NOT_A_PROMPT",
        "echo 'single-quoted'",
        "echo \"double-quoted\""
      ]
    },
    {
      "n": 6,
      "title": "skip_if does not fire for yzx",
      "cmds": [
        {
          "text": "echo SKIP_IF_RAN",
          "skip_if": "already_omm",
          "wait": "shell"
        },
        {
          "text": "echo BOX6_DONE",
          "wait": "shell"
        }
      ]
    }
  ]
}
